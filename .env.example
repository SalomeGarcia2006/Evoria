MONGO_ROOT_USERNAME=evoria
MONGO_ROOT_PASSWORD=evoria_local_password
MONGO_DATABASE=evoria
WEB_ORIGIN=http://localhost:3000

# Secretos de autenticación. Usa valores distintos y aleatorios.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECURE=false

# Google OAuth: registra GOOGLE_REDIRECT_URI como URI autorizada en Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback

# Activa Turnstile cuando hayas configurado las claves en API y frontend.
CAPTCHA_ENABLED=false
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Envío de correos con Brevo SMTP. El usuario SMTP no es el remitente.
BREVO_SMTP_USER=
BREVO_SMTP_KEY=
MAIL_FROM_EMAIL=

# Cuenta global inicial creada al ejecutar npm run seed. Define valores propios.
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
