PORT=3001
WEB_ORIGIN=http://localhost:3000
MONGO_ROOT_USERNAME=evoria
MONGO_ROOT_PASSWORD=evoria_local_password
MONGO_DATABASE=evoria
# Define MONGODB_URI solo para conectarte a una instancia externa de MongoDB.

# Secretos de autenticación. Usa valores distintos y aleatorios.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECURE=false

# Empresa y cuenta inicial creadas al ejecutar npm run seed. Define valores propios.
SEED_TENANT_NAME=
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
