PORT=3001
WEB_ORIGIN=http://localhost:3000
MONGO_ROOT_USERNAME=evoria
MONGO_ROOT_PASSWORD=evoria_local_password
MONGO_DATABASE=evoria
# Por defecto la API usa la réplica local evoria-rs mediante conexión directa.
# Define MONGODB_URI si utilizas otra instancia o configuración de MongoDB.

# Secretos de autenticación. Usa valores distintos y aleatorios.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECURE=false

# Cuenta global inicial creada al ejecutar npm run seed. Define valores propios.
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
