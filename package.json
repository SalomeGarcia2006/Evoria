{
  "name": "evoria",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.19.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "seed": "npm run seed:admin",
    "seed:access-control": "npm run build --workspace=@evoria/api && npm run seed:access-control --workspace=@evoria/api",
    "seed:admin": "npm run build --workspace=@evoria/api && npm run seed:admin --workspace=@evoria/api",
    "docker:dev": "docker compose -f compose.yaml -f compose.dev.yaml watch",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "lint-staged": {
    "apps/api/**/*.{ts,tsx}": [
      "eslint --fix --config apps/api/eslint.config.mjs",
      "prettier --write"
    ],
    "apps/web/**/*.{ts,tsx}": [
      "eslint --fix --config apps/web/eslint.config.mjs",
      "prettier --write"
    ],
    "packages/contracts/**/*.{ts,tsx}": "prettier --write",
    "*.{css,js,jsx,json,md,mjs,yaml,yml}": "prettier --write"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "3.9.9",
    "turbo": "2.11.7"
  }
}
